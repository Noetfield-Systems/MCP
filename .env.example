PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcpfoundry
PUBLIC_URL=http://localhost:3000
# Required in production for secure session cookies (set automatically based on NODE_ENV)
NODE_ENV=development
# Optional live billing; never put real credentials in GitHub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional GitHub OAuth connection for PRIVATE owner-authenticated MCP servers.
# Register callback: https://<PUBLIC_URL_HOST>/api/oauth/github/callback
# Leave unset to disable OAuth safely until your own GitHub OAuth app is ready.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 32 random bytes as 64 hexadecimal characters; generate/store only in a secret manager.
FOUNDRY_OAUTH_ENCRYPTION_KEY=

# Optional BYOK support: 64-character hex AES-256 key in Railway. Generate once and protect; never commit a real value.
FOUNDRY_UPSTREAM_ENCRYPTION_KEY=

# Optional merchant-authorized Judge.me connector, read-only Shopify pilot.
# Register callback: https://YOUR_DOMAIN/api/integrations/judgeme/callback
# Reuses FOUNDRY_OAUTH_ENCRYPTION_KEY already defined above.
JUDGEME_CLIENT_ID=
JUDGEME_CLIENT_SECRET=
